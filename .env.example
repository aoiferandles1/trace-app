# Copy to .env.local and fill in. Never commit real values.
# There is no Supabase secret key in this project, on purpose (PLAN.md section 0).

# Public: safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Server only: never prefix with NEXT_PUBLIC_, never import from a client component.
PORTAL_SERVER_SECRET=
CRON_SECRET=
IP_HASH_SALT=
